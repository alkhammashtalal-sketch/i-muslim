# Security headers for static files (Workers Static Assets serves them without running the Worker).
# Must match worker/src/security.ts, which covers /api/*; worker/test/security.test.ts checks both.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; media-src 'self' blob: https://cdn.mp3quran.net; connect-src 'self' https://cdn.mp3quran.net; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=(self), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000

# The reviewed translations of al-Muyassar (command 21): an hour's cache, so a withdrawn or corrected one reaches readers soon.
/explain/*
  Cache-Control: public, max-age=3600

# The alerts' sounds (add-on 0072-add20 §1): the app reads /sounds/manifest.json from its own origin
# (capacitor://localhost, https://localhost), which static files answer without the Worker's CORS (worker/src/cors.ts),
# so it is open to any origin: public data, no credentials, nothing personal. A short cache, so an approval reaches the
# phones within minutes; each file is checked on the phone by the manifest's SHA-256 anyway.
/sounds/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
