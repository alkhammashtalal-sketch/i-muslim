<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The App Store Connect upload of web/scripts/ios-build.sh upload (reply 0033-add5): signed automatically for team
     Z5XP77C6S7. The version and build number stay the project's. No «TestFlight internal only» option since build 16
     (reply 0064): a build uploaded with it is INTERNAL_ONLY, and App Store Connect will not add it to an App Store
     version; without it the build is APP_STORE_ELIGIBLE and still goes to TestFlight. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>Z5XP77C6S7</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
