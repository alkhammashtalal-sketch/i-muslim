"NSLocationWhenInUseUsageDescription" = "Lokasi anda digunakan pada peranti anda untuk mengira waktu solat dan arah kiblat. Lokasi tepat anda tidak pernah dihantar ke mana-mana pelayan.";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "Lokasi anda digunakan pada peranti anda untuk mengira waktu solat dan arah kiblat. Lokasi tepat anda tidak pernah dihantar ke mana-mana pelayan.";

"NSMicrophoneUsageDescription" = "Mikrofon hanya digunakan apabila anda menekan butangnya untuk bertanya dengan suara. Rakaman dihantar untuk ditukar kepada teks, yang muncul dalam kotak soalan untuk anda semak dan hantar. Suara tidak disimpan.";

"NSPhotoLibraryAddUsageDescription" = "Hanya digunakan apabila anda memilih Simpan Imej semasa berkongsi sesuatu ayat, untuk menambah imej itu ke Foto anda.";

/* «Add to the phone’s calendar» (reply 0062): write-only access; the app never reads the calendar. */
"NSCalendarsWriteOnlyAccessUsageDescription" = "Digunakan hanya apabila anda memilih untuk menambah acara atau peristiwa ke kalendar anda. Aplikasi boleh menambah acara tetapi tidak boleh membaca kalendar anda.";

/* Penggera Subuh (0072-add34 §ب6) */
"NSAlarmKitUsageDescription" = "Digunakan hanya apabila anda menghidupkan penggera Subuh dalam Tetapan, supaya ia berbunyi pada waktu Subuh walaupun telefon dalam mod senyap. Anda boleh mematikannya pada bila-bila masa.";
