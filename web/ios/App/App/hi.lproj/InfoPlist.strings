"NSLocationWhenInUseUsageDescription" = "आपके डिवाइस पर ही नमाज़ के समय और क़िबला की दिशा निकालने के लिए आपकी लोकेशन इस्तेमाल होती है। आपकी सटीक लोकेशन किसी सर्वर को नहीं भेजी जाती।";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "आपके डिवाइस पर ही नमाज़ के समय और क़िबला की दिशा निकालने के लिए आपकी लोकेशन इस्तेमाल होती है। आपकी सटीक लोकेशन किसी सर्वर को नहीं भेजी जाती।";

"NSMicrophoneUsageDescription" = "माइक्रोफ़ोन तभी इस्तेमाल होता है जब आप आवाज़ से सवाल पूछने के लिए उसका बटन दबाते हैं। रिकॉर्डिंग को टेक्स्ट में बदलने के लिए भेजा जाता है, जो सवाल के बॉक्स में आता है ताकि आप उसे देखकर भेजें। आवाज़ सहेजी नहीं जाती।";

"NSPhotoLibraryAddUsageDescription" = "केवल तब इस्तेमाल होता है जब आप ऐप में बनाई गई इमेज (आयत की इमेज या «कार्ड बनाएँ») सेव करना चुनते हैं, ताकि वह आपकी फ़ोटो में जुड़ जाए।";

/* «Add to the phone’s calendar» (reply 0062): write-only access; the app never reads the calendar. */
"NSCalendarsWriteOnlyAccessUsageDescription" = "केवल तब उपयोग होता है जब आप अपने कैलेंडर में कोई इवेंट या अवसर जोड़ना चुनते हैं। ऐप इवेंट जोड़ सकता है, पर आपका कैलेंडर पढ़ नहीं सकता।";
