/* The App Shortcuts' phrases (reply 0050 د); ${applicationName} is the name under the icon. */
"Travel prayer in ${applicationName}" = "سفر کی دعا ${applicationName} میں";
"Sleep adhkar in ${applicationName}" = "سونے کے اذکار ${applicationName} میں";
"Waking adhkar in ${applicationName}" = "جاگنے کے اذکار ${applicationName} میں";
"Entering home in ${applicationName}" = "گھر میں داخل ہونا ${applicationName} میں";
"Leaving home in ${applicationName}" = "گھر سے نکلنا ${applicationName} میں";
"Mosque adhkar in ${applicationName}" = "مسجد کے اذکار ${applicationName} میں";
"Food adhkar in ${applicationName}" = "کھانے کے اذکار ${applicationName} میں";

/* Siri (add-on 0072-add30 §4): the next prayer, the tasbih, the day's Name; Siri speaks ar, en, fr, es, tr and ms. */
"When is the next prayer in ${applicationName}" = "${applicationName} میں اگلی نماز کب ہے";
"Next prayer in ${applicationName}" = "${applicationName} میں اگلی نماز";
"Open the tasbih in ${applicationName}" = "${applicationName} میں تسبیح کھولیں";
"Tasbih in ${applicationName}" = "${applicationName} میں تسبیح";
"Name of Allah for today in ${applicationName}" = "${applicationName} میں آج کا اسمِ الٰہی";
"Today's Name of Allah in ${applicationName}" = "${applicationName} میں آج کا اسمِ الٰہی کیا ہے";
