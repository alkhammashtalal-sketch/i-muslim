/* Device permission texts (0048-add2 §6: the ten languages in the bundle, so iOS offers the app's language and the App
   Store lists them), the meaning of the reviewed English and Arabic texts (reply 0033 §B3, §B5), machine-translated like
   the rest of the interface. */

"NSLocationWhenInUseUsageDescription" = "آپ کا مقام آپ کے آلے پر نماز کے اوقات اور قبلے کی سمت معلوم کرنے کے لیے استعمال ہوتا ہے۔ آپ کا درست مقام کسی سرور کو نہیں بھیجا جاتا۔";

"NSLocationAlwaysAndWhenInUseUsageDescription" = "آپ کا مقام آپ کے آلے پر نماز کے اوقات اور قبلے کی سمت معلوم کرنے کے لیے استعمال ہوتا ہے۔ آپ کا درست مقام کسی سرور کو نہیں بھیجا جاتا۔";

"NSMicrophoneUsageDescription" = "مائیکروفون صرف اس وقت استعمال ہوتا ہے جب آپ آواز سے سوال پوچھنے کے لیے اس کا بٹن دبائیں۔ ریکارڈنگ متن میں بدلنے کے لیے بھیجی جاتی ہے، جو سوال کے خانے میں آتا ہے تاکہ آپ اسے دیکھ کر بھیجیں۔ آواز محفوظ نہیں کی جاتی۔";

"NSPhotoLibraryAddUsageDescription" = "صرف اس وقت استعمال ہوتا ہے جب آپ ایپ میں بنائی ہوئی تصویر (آیت کی تصویر یا «کارڈ بنائیں») محفوظ کرنا چنیں، تاکہ وہ آپ کی تصاویر میں شامل ہو۔";

/* «Add to the phone’s calendar» (reply 0062): write-only access; the app never reads the calendar. */
"NSCalendarsWriteOnlyAccessUsageDescription" = "صرف اس وقت استعمال ہوتا ہے جب آپ کوئی تقریب یا مواقع اپنے کیلنڈر میں شامل کرنا چنیں۔ ایپ تقریبات شامل کر سکتی ہے، مگر آپ کا کیلنڈر پڑھ نہیں سکتی۔";

/* فجر کا الارم (0072-add34 §ب6) */
"NSAlarmKitUsageDescription" = "صرف اس وقت استعمال ہوتا ہے جب آپ ترتیبات میں فجر کا الارم آن کریں، تاکہ فون خاموش ہو تب بھی فجر کے وقت بجے۔ آپ اسے جب چاہیں بند کر سکتے ہیں۔";
