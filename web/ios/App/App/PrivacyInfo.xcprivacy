<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest (reply 0033 §B5), from the code, not from memory. Re-check it whenever a plugin or a
  server route is added (worker/test/native-shell.test.ts holds it to this list).

  Tracking: none. No tracking domains, no advertising, no analytics, no accounts.

  Required-reason APIs: none in the app's own code (AppDelegate.swift, SceneDelegate.swift have none). Capacitor
  8.5.3 declares none of its own (its PrivacyInfo.xcprivacy and Cordova's are empty; its only use of CommonCrypto is a
  SHA-256 hash). The web view's localStorage belongs to WebKit, a system framework. Each Capacitor plugin added later
  (local notifications, geolocation, share, haptics…) ships its own manifest; re-check what each one declares.

  Data sent from the device and kept on the server (docs/PRIVACY.md, worker/src):
    - Other user content: a reported mistake (kind, place, optional note of up to 500 characters; POST /api/report)
      and a requested language (its normalised name, counted per month; POST /api/lang-request). Kept with the day
      only: no identifier, not linked to the person.
    - Coarse location: nearby mosques send a cell rounded to 0.01° (about 1 km; GET /api/mosques); the server keeps
      OpenStreetMap's answer for that cell a week. Not linked to the person. The exact position never leaves the
      device (prayer times and the qibla are computed on it).
  Sent but not kept (processed in real time, so not "collected"): the question (POST /api/ask; the cache keeps a
  SHA-256 of the normalised question, never its text), the voice recording (POST /api/transcribe; not stored), the
  text sent to «بسّط لي» (a tafsir or passage text and the language). The daily limit keeps an HMAC of the IP address
  and the date, which changes every day; the address itself is not stored.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
