<?xml version="1.0" encoding="utf-8"?>
<!-- The app's languages in Android's own per-app language setting (Android 13+; reply 0066), the ten of the interface,
     as the iPhone app lists them (CFBundleLocalizations). The web view takes the chosen one as navigator.languages. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ar" />
    <locale android:name="en" />
    <locale android:name="ur" />
    <locale android:name="id" />
    <locale android:name="ms" />
    <locale android:name="tr" />
    <locale android:name="fr" />
    <locale android:name="es" />
    <locale android:name="bn" />
    <locale android:name="hi" />
</locale-config>
