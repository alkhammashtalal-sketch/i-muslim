# The site's headers (reply 0033 §ج): nothing from any other server. Scripts, styles, fonts and images from this site
# only, no inline code; the one connection is the support form's POST to the app's server (/api/report). If that
# server's address changes, change connect-src here and data-api in support.html and en/support.html together
# (worker/test/site.test.ts checks they agree).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src https://i-muslim-next.alkhammashtalal.workers.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
