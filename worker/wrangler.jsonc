{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "i-muslim",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imuslim",
      "database_id": "2cbc4d13-be31-4043-9105-241aae43e76e"
    }
  ],
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "imuslim-passages" }
  ],
  "vars": { "ADMIN_ENABLED": "false", "LLM_MODE": "live", "EXPLAIN_MODE": "on_demand", "READER_EXPLAIN": "false", "MUKHTASAR_PUBLIC": "false", "MUKHTASAR_QURANENC": "true" },
  "observability": { "enabled": true },
  "env": {
    "next": {
      "name": "i-muslim-next",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imuslim-next",
          "database_id": "22bc931b-3fcc-4b52-9cd8-1547525d4144"
        }
      ],
      // The hadiths' vectors (reply 0048): their own index, asked only when HADITH_RETRIEVAL is "on".
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "imuslim-next-passages" },
        { "binding": "VECTORIZE_HADITH", "index_name": "imuslim-next-hadiths" }
      ],
      "vars": { "ADMIN_ENABLED": "false", "LLM_MODE": "live", "EXPLAIN_MODE": "on_demand", "READER_EXPLAIN": "false", "MUKHTASAR_PUBLIC": "false", "MUKHTASAR_QURANENC": "true", "HADITH_RETRIEVAL": "off", "HADITH_GRADE": "on" },
      // Prayer bells (reply 0032 part E): every minute, next only. Idle until VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY are set.
      // «نتابع إصداراتهم» (reply 0033 §أ3): the first of each month at 03:00 UTC, the sources' versions (src/sources.ts).
      "triggers": { "crons": ["* * * * *", "0 3 1 * *"] },
      // Reply 0037 §5: at most 6 new model calls a minute per device (worker/src/limits.ts, limits.json burstPerMinute),
      // keyed by the daily device key. Counted per Cloudflare location and eventually consistent, by design
      // (developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/; wrangler 4.36 or later). The namespace is
      // this Worker's own: no other Worker in the account uses 37001.
      "ratelimits": [{ "name": "BURST", "namespace_id": "37001", "simple": { "limit": 6, "period": 60 } }],
      // No invocation logs (the privacy policy, site/public/privacy.html, and docs/PRIVACY.md): Workers Logs would
      // otherwise keep one entry per request for 7 days, with its full URL (a mosque cell) and the request's metadata.
      // The few console lines (crons, a failed model call) stay; none holds a question, a cell or an address.
      "observability": { "enabled": true, "logs": { "invocation_logs": false } }
    },
    // Release 1.1's own server (reply 0070 step 1, reply 0071): its own D1 and Vectorize, built from the repository
    // (docs/ENVIRONMENTS.md, «v11»). Nothing here reaches next but a promotion on Talal's order. ADMIN_ENABLED is "true"
    // for the indexing routes and the measurements (eval/run-basic.mjs), behind its own ADMIN_TOKEN. No crons: v11 sends
    // no prayer bell and checks no source. Its rate-limit namespace (37011) is its own.
    "v11": {
      "name": "i-muslim-v11",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "imuslim-v11",
          "database_id": "a591cf73-9c19-438f-a7c9-39be0d5d3c18"
        }
      ],
      "vectorize": [
        { "binding": "VECTORIZE", "index_name": "imuslim-v11-passages" },
        { "binding": "VECTORIZE_HADITH", "index_name": "imuslim-v11-hadiths" }
      ],
      "vars": { "ADMIN_ENABLED": "true", "LLM_MODE": "live", "EXPLAIN_MODE": "on_demand", "READER_EXPLAIN": "false", "MUKHTASAR_PUBLIC": "false", "MUKHTASAR_QURANENC": "true", "HADITH_RETRIEVAL": "off", "HADITH_GRADE": "on", "ASK_QUEUE": "on", "ASK_RATE": "6" },
      "triggers": { "crons": [] },
      "ratelimits": [{ "name": "BURST", "namespace_id": "37011", "simple": { "limit": 6, "period": 60 } }],
      // «اسأل»'s queue (add-ons 0071-add3 §1 and 0071-add4; src/queue.ts): one SQLite-backed Durable Object. ASK_RATE is
      // its window by day (6 model calls a minute, add-on 0071-add2 §6); the night's tests set theirs by the admin route.
      "durable_objects": { "bindings": [{ "name": "ASK_JOBS", "class_name": "AskQueue" }] },
      "migrations": [{ "tag": "v1-ask-queue", "new_sqlite_classes": ["AskQueue"] }],
      "observability": { "enabled": true, "logs": { "invocation_logs": false } }
    }
  }
}
